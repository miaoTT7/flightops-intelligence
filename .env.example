# Copy this file to .env and choose a local-only password.
POSTGRES_DB=flightops
POSTGRES_USER=flightops
POSTGRES_PASSWORD=change_me_for_local_development
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55433

# Used by the Python ingestion CLI after loading .env into the shell.
DATABASE_URL=postgresql://flightops:change_me_for_local_development@127.0.0.1:55433/flightops

# dbt uses the same PostgreSQL connection and keeps generated models in a
# separate schema. Step 1 only declares sources; it does not create this schema.
DBT_TARGET_SCHEMA=analytics
DBT_THREADS=4

